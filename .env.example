# APPLICATION
APP_NAME=QBR Intelligence Pipeline
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# POSTGRESQL
POSTGRES_DB=qbr_db
POSTGRES_USER=qbr
POSTGRES_PASSWORD=qbr
POSTGRES_PORT=5432

# PostgreSQL running in Docker, FastAPI running on Ubuntu
DATABASE_URL=postgresql+asyncpg://qbr:qbr@127.0.0.1:5432/qbr_db

# Extraction pipeline
QBR_PIPELINE_FACTORY=qbr.bootstrap.pipeline_factory:create_pipeline

DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# FASTAPI
QBR_HOST=127.0.0.1
QBR_PORT=8000
QBR_RELOAD=true

# EXTRACTION
# Replace with the real module:function in your project.
# QBR_PIPELINE_FACTORY=qbr.bootstrap.pipeline_factory:create_pipeline

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# OPENAI SDK
OPENAI_API_KEY=

# PDF
QBR_UPLOAD_DIR=data/uploads
PDF_MAX_SIZE_MB=20
PDF_MAX_PAGES=100
PDF_TABLE_EXTRACTION=true

# VALIDATION
VALIDATION_MIN_CONFIDENCE=0.80
VALIDATION_REQUIRE_EVIDENCE=true

# VECTOR
QBR_VECTOR_ENABLED=true
QBR_EMBEDDING_MODEL=text-embedding-3-small
QBR_EMBEDDING_DIMENSIONS=1536
QBR_CHUNK_MAX_TOKENS=700
QBR_CHUNK_OVERLAP_TOKENS=70

# EXISTING APP SETTINGS
VECTORIZATION_ENABLED=true
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=70

# OPTIONAL EVALUATION
DEEPEVAL_ENABLED=false
DEEPEVAL_THRESHOLD=0.80

# OPTIONAL OBSERVABILITY
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com