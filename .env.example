
# ==========================================
# QBR INTELLIGENCE - ENVIRONMENT
# ==========================================

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL + pgvector
POSTGRES_DB=qbr_db
POSTGRES_USER=qbr
POSTGRES_PASSWORD=change_me_securely
POSTGRES_PORT=5432

# FastAPI running locally on Ubuntu
DATABASE_URL=postgresql+asyncpg://qbr:change_me_securely@127.0.0.1:5432/qbr_db

# For FastAPI running inside Docker Compose,
# replace DATABASE_URL with:
# DATABASE_URL=postgresql+asyncpg://qbr:change_me_securely@db:5432/qbr_db

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_admin_password

# OpenAI
OPENAI_API_KEY=replace_with_your_openai_api_key

# Existing QBR pipeline
QBR_PIPELINE_FACTORY=qbr.bootstrap.pipeline_factory:create_pipeline

QBR_VECTOR_ENABLED=true

# PDF ingestion stage
QBR_INGESTION_ROOT=data/ingestion
QBR_MAX_PDF_BYTES=26214400

# Vector search
QBR_EMBEDDING_MODEL=text-embedding-3-small
QBR_VECTOR_TOP_K=5

# Pipeline orchestration (planned V4 settings)
QBR_PIPELINE_MAX_RETRIES=3
QBR_PIPELINE_TIMEOUT_SECONDS=300
QBR_STAGE_TIMEOUT_SECONDS=120
QBR_ENABLE_CHECKPOINTS=true
QBR_ENABLE_EXECUTION_METRICS=true

# Observability (planned integrations)
OTEL_SERVICE_NAME=qbr-intelligence
OTEL_TRACES_ENABLED=false
LANGFUSE_ENABLED=false

# React frontend
VITE_API_BASE_URL=http://localhost:8000
